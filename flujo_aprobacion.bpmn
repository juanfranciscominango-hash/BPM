<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Analisis" name="3. Análisis de Crédito">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_Evaluar" name="Evaluar Matriz de Aprobación" camunda:decisionRef="matriz_aprobacion" camunda:resultVariable="rol_aprobador" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="¿Qué nivel aprueba?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Asesor</bpmn:outgoing>
      <bpmn:outgoing>Flow_Jefe</bpmn:outgoing>
      <bpmn:outgoing>Flow_Subgerente</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gerente</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Asesor" name="Validar consideraciones (Asesor)">
      <bpmn:incoming>Flow_Asesor</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Jefe" name="Validar consideraciones (Jefe)">
      <bpmn:incoming>Flow_Jefe</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Subgerente" name="Validar consideraciones (Subgerente)">
      <bpmn:incoming>Flow_Subgerente</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Gerente" name="Validar consideraciones (Gerente)">
      <bpmn:incoming>Flow_Gerente</bpmn:incoming>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Analisis" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Analisis" targetRef="Task_Evaluar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Evaluar" targetRef="Gateway_1" />
    
    <bpmn:sequenceFlow id="Flow_Asesor" name="Asesor" sourceRef="Gateway_1" targetRef="Task_Asesor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol_aprobador == 'ASESOR_CREDITO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Jefe" name="Jefe" sourceRef="Gateway_1" targetRef="Task_Jefe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol_aprobador == 'JEFE_CREDITO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Subgerente" name="Subgerente" sourceRef="Gateway_1" targetRef="Task_Subgerente">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol_aprobador == 'SUBGERENTE_CREDITO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gerente" name="Gerente" sourceRef="Gateway_1" targetRef="Task_Gerente">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol_aprobador == 'GERENTE_CREDITO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDI>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
      <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
        <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
          <dc:Bounds x="152" y="272" width="36" height="36" />
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Task_Analisis_di" bpmnElement="Task_Analisis">
          <dc:Bounds x="240" y="250" width="100" height="80" />
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Task_Evaluar_di" bpmnElement="Task_Evaluar">
          <dc:Bounds x="400" y="250" width="100" height="80" />
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
          <dc:Bounds x="565" y="265" width="50" height="50" />
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Task_Asesor_di" bpmnElement="Task_Asesor">
          <dc:Bounds x="720" y="80" width="100" height="80" />
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Task_Jefe_di" bpmnElement="Task_Jefe">
          <dc:Bounds x="720" y="190" width="100" height="80" />
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Task_Subgerente_di" bpmnElement="Task_Subgerente">
          <dc:Bounds x="720" y="300" width="100" height="80" />
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Task_Gerente_di" bpmnElement="Task_Gerente">
          <dc:Bounds x="720" y="410" width="100" height="80" />
        </bpmndi:BPMNShape>
        
        <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
          <di:waypoint x="188" y="290" />
          <di:waypoint x="240" y="290" />
        </bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
          <di:waypoint x="340" y="290" />
          <di:waypoint x="400" y="290" />
        </bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
          <di:waypoint x="500" y="290" />
          <di:waypoint x="565" y="290" />
        </bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="Flow_Asesor_di" bpmnElement="Flow_Asesor">
          <di:waypoint x="590" y="265" />
          <di:waypoint x="590" y="120" />
          <di:waypoint x="720" y="120" />
        </bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="Flow_Jefe_di" bpmnElement="Flow_Jefe">
          <di:waypoint x="615" y="290" />
          <di:waypoint x="668" y="290" />
          <di:waypoint x="668" y="230" />
          <di:waypoint x="720" y="230" />
        </bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="Flow_Subgerente_di" bpmnElement="Flow_Subgerente">
          <di:waypoint x="615" y="290" />
          <di:waypoint x="668" y="290" />
          <di:waypoint x="668" y="340" />
          <di:waypoint x="720" y="340" />
        </bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="Flow_Gerente_di" bpmnElement="Flow_Gerente">
          <di:waypoint x="590" y="315" />
          <di:waypoint x="590" y="450" />
          <di:waypoint x="720" y="450" />
        </bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
  </bpmndi:BPMNDI>
</bpmn:definitions>
